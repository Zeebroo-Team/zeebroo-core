{
  "name": "zeebroo-pos-desktop",
  "version": "6.27.0",
  "description": "Zeebroo POS Desktop — Electron ribbon interface",
  "author": {
    "name": "Zeebroo",
    "email": "support@zeebroo.com"
  },
  "homepage": "https://zeebroo.com",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/start.js",
    "dev": "node scripts/start.js",
    "prebuild": "node scripts/setApiUrl.js",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "42.11.18",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.61.0"
  },
  "build": {
    "appId": "com.zeebroo.pos-desktop",
    "productName": "Zeebroo POS",
    "copyright": "Copyright © 2025 Zeebroo",
    "afterPack": "./scripts/afterPack.js",
    "directories": {
      "output": "dist",
      "buildResources": "build-assets"
    },
    "files": [
      "main.js",
      "config.js",
      "offline.js",
      "preload.js",
      "renderer/**/*",
      "node_modules/**/*",
      "!**/*.map",
      "!**/*.d.ts"
    ],
    "mac": {
      "icon": "build-assets/icon.icns",
      "category": "public.app-category.business",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build-assets/entitlements.mac.plist",
      "entitlementsInherit": "build-assets/entitlements.mac.plist",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build-assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "icon": "build-assets/icon.png",
      "category": "Office",
      "maintainer": "Zeebroo <support@zeebroo.com>",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  },
  "overrides": {
    "fast-uri": "^3.1.9",
    "brace-expansion": "^5.0.12",
    "@xmldom/xmldom": "^0.8.15",
    "tar": "^7.5.21",
    "minimatch@^9.0.0": "^11.0.1",
    "minimatch@^10.0.0": "^11.0.1"
  }
}
